<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="codex">
        <sql>create schema if not exists catalog</sql>
    </changeSet>

    <!-- Core tables -->
    <changeSet id="2" author="codex">
        <createTable tableName="artists" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_artists"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="varchar(2048)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="codex">
        <createTable tableName="albums" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_albums"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="released_at" type="varchar(10)"/>
            <column name="image_url" type="varchar(2048)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="codex">
        <createTable tableName="releases" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_releases"/>
            </column>
            <column name="album_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="released_at" type="varchar(10)"/>
            <column name="image_url" type="varchar(2048)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5" author="codex">
        <createTable tableName="songs" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_songs"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="released_at" type="varchar(10)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="6" author="codex">
        <createTable tableName="tracks" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_tracks"/>
            </column>
            <column name="song_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="release_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="varchar(2048)"/>
            <column name="duration_seconds" type="int"/>
            <column name="released_at" type="varchar(10)"/>
            <column name="disc_number" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="track_number" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Social identity tables -->
    <changeSet id="7" author="codex">
        <createTable tableName="artist_social" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_artist_social"/>
            </column>
            <column name="artist_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="spotify_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="8" author="codex">
        <createTable tableName="release_social" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_release_social"/>
            </column>
            <column name="release_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="spotify_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="9" author="codex">
        <createTable tableName="track_social" schemaName="catalog">
            <column name="id" type="uuid">
                <constraints
                        nullable="false"
                        primaryKey="true"
                        primaryKeyName="pk_track_social"/>
            </column>
            <column name="track_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="spotify_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Many-to-many link tables -->
    <changeSet id="10" author="codex">
        <createTable tableName="album_artists" schemaName="catalog">
            <column name="album_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="artist_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="11" author="codex">
        <createTable tableName="song_artists" schemaName="catalog">
            <column name="song_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="artist_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Unique constraints -->
    <changeSet id="12" author="codex">
        <addUniqueConstraint
                tableName="releases"
                schemaName="catalog"
                columnNames="album_id, title"
                constraintName="uk_releases_album_title"/>
        <addUniqueConstraint
                tableName="tracks"
                schemaName="catalog"
                columnNames="release_id, disc_number, track_number"
                constraintName="uk_tracks_position"/>
        <addUniqueConstraint
                tableName="artist_social"
                schemaName="catalog"
                columnNames="artist_id"
                constraintName="uk_artist_social_artist"/>
        <addUniqueConstraint
                tableName="artist_social"
                schemaName="catalog"
                columnNames="spotify_id"
                constraintName="uk_artist_social_spotify_id"/>
        <addUniqueConstraint
                tableName="release_social"
                schemaName="catalog"
                columnNames="release_id"
                constraintName="uk_release_social_release"/>
        <addUniqueConstraint
                tableName="release_social"
                schemaName="catalog"
                columnNames="spotify_id"
                constraintName="uk_release_social_spotify_id"/>
        <addUniqueConstraint
                tableName="track_social"
                schemaName="catalog"
                columnNames="track_id"
                constraintName="uk_track_social_track"/>
        <addUniqueConstraint
                tableName="track_social"
                schemaName="catalog"
                columnNames="spotify_id"
                constraintName="uk_track_social_spotify_id"/>
        <addUniqueConstraint
                tableName="album_artists"
                schemaName="catalog"
                columnNames="album_id, artist_id"
                constraintName="uk_album_artists_album_artist"/>
        <addUniqueConstraint
                tableName="song_artists"
                schemaName="catalog"
                columnNames="song_id, artist_id"
                constraintName="uk_song_artists_song_artist"/>
    </changeSet>

    <!-- Foreign keys -->
    <changeSet id="13" author="codex">
        <addForeignKeyConstraint
                baseTableName="releases"
                baseTableSchemaName="catalog"
                baseColumnNames="album_id"
                referencedTableName="albums"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_releases_album"/>
        <addForeignKeyConstraint
                baseTableName="tracks"
                baseTableSchemaName="catalog"
                baseColumnNames="song_id"
                referencedTableName="songs"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_tracks_song"/>
        <addForeignKeyConstraint
                baseTableName="tracks"
                baseTableSchemaName="catalog"
                baseColumnNames="release_id"
                referencedTableName="releases"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_tracks_release"/>
        <addForeignKeyConstraint
                baseTableName="artist_social"
                baseTableSchemaName="catalog"
                baseColumnNames="artist_id"
                referencedTableName="artists"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_artist_social_artist"/>
        <addForeignKeyConstraint
                baseTableName="release_social"
                baseTableSchemaName="catalog"
                baseColumnNames="release_id"
                referencedTableName="releases"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_release_social_release"/>
        <addForeignKeyConstraint
                baseTableName="track_social"
                baseTableSchemaName="catalog"
                baseColumnNames="track_id"
                referencedTableName="tracks"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_track_social_track"/>
        <addForeignKeyConstraint
                baseTableName="album_artists"
                baseTableSchemaName="catalog"
                baseColumnNames="album_id"
                referencedTableName="albums"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_album_artists_album"/>
        <addForeignKeyConstraint
                baseTableName="album_artists"
                baseTableSchemaName="catalog"
                baseColumnNames="artist_id"
                referencedTableName="artists"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_album_artists_artist"/>
        <addForeignKeyConstraint
                baseTableName="song_artists"
                baseTableSchemaName="catalog"
                baseColumnNames="song_id"
                referencedTableName="songs"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_song_artists_song"/>
        <addForeignKeyConstraint
                baseTableName="song_artists"
                baseTableSchemaName="catalog"
                baseColumnNames="artist_id"
                referencedTableName="artists"
                referencedTableSchemaName="catalog"
                referencedColumnNames="id"
                constraintName="fk_song_artists_artist"/>
    </changeSet>

    <!-- Supporting indexes -->
    <changeSet id="14" author="codex">
        <createIndex tableName="releases" schemaName="catalog" indexName="ix_releases_album_id">
            <column name="album_id"/>
        </createIndex>
        <createIndex tableName="tracks" schemaName="catalog" indexName="ix_tracks_song_id">
            <column name="song_id"/>
        </createIndex>
        <createIndex tableName="tracks" schemaName="catalog" indexName="ix_tracks_release_id">
            <column name="release_id"/>
        </createIndex>
        <createIndex tableName="artist_social" schemaName="catalog" indexName="ix_artist_social_artist_id">
            <column name="artist_id"/>
        </createIndex>
        <createIndex tableName="release_social" schemaName="catalog" indexName="ix_release_social_release_id">
            <column name="release_id"/>
        </createIndex>
        <createIndex tableName="track_social" schemaName="catalog" indexName="ix_track_social_track_id">
            <column name="track_id"/>
        </createIndex>
        <createIndex tableName="album_artists" schemaName="catalog" indexName="ix_album_artists_album_id">
            <column name="album_id"/>
        </createIndex>
        <createIndex tableName="album_artists" schemaName="catalog" indexName="ix_album_artists_artist_id">
            <column name="artist_id"/>
        </createIndex>
        <createIndex tableName="song_artists" schemaName="catalog" indexName="ix_song_artists_song_id">
            <column name="song_id"/>
        </createIndex>
        <createIndex tableName="song_artists" schemaName="catalog" indexName="ix_song_artists_artist_id">
            <column name="artist_id"/>
        </createIndex>
    </changeSet>

    <!-- Data integrity checks -->
    <changeSet id="15" author="codex">
        <sql>
            alter table catalog.albums
                add constraint ck_albums_released_at_format
                    check (released_at is null or released_at ~ '^\d{4}(-\d{2})?(-\d{2})?$')
        </sql>
        <sql>
            alter table catalog.releases
                add constraint ck_releases_released_at_format
                    check (released_at is null or released_at ~ '^\d{4}(-\d{2})?(-\d{2})?$')
        </sql>
        <sql>
            alter table catalog.songs
                add constraint ck_songs_released_at_format
                    check (released_at is null or released_at ~ '^\d{4}(-\d{2})?(-\d{2})?$')
        </sql>
        <sql>
            alter table catalog.tracks
                add constraint ck_tracks_released_at_format
                    check (released_at is null or released_at ~ '^\d{4}(-\d{2})?(-\d{2})?$')
        </sql>
        <sql>
            alter table catalog.tracks
                add constraint ck_tracks_duration_seconds_positive
                    check (duration_seconds is null or duration_seconds &gt; 0)
        </sql>
        <sql>
            alter table catalog.tracks
                add constraint ck_tracks_disc_number_positive
                    check (disc_number &gt; 0)
        </sql>
        <sql>
            alter table catalog.tracks
                add constraint ck_tracks_track_number_positive
                    check (track_number &gt; 0)
        </sql>
    </changeSet>

    <changeSet id="16" author="codex">
        <sql>
            create unique index uk_releases_default_per_album
                on catalog.releases (album_id) where is_default = true
        </sql>
    </changeSet>

    <changeSet id="17" author="codex">

    </changeSet>
</databaseChangeLog>
